{
  "name": "game-glance",
  "version": "3.0.2",
  "description": "Immersive game page for Steam Game Mode: full-screen art, HowLongToBeat times, descriptions and store info",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:hltb": "vitest run --config vitest.live.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@types/fast-levenshtein": "^0.0.2",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "linkedom": "^0.18.13",
    "react": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "fast-levenshtein": "^3.0.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
